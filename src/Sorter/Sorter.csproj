<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- the real version comes from the git tag in the release workflow -->
		<Version>0.0.0-dev</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/kubbit98/Sorter</PackageProjectUrl>
		<AssemblyVersion></AssemblyVersion>
		<Title>Sorter</Title>
		<NeutralLanguage>en-001</NeutralLanguage>
		<PackageLicenseFile>COPYING</PackageLicenseFile>
		<!-- precompressed .gz/.br copies of static assets only help over a network, the app runs on localhost
		     and they added ~30 MB to the unpacked package -->
		<CompressionEnabled>false</CompressionEnabled>
	</PropertyGroup>

	<ItemGroup>
		<Content Update="TestFolder\**" CopyToPublishDirectory="Never" />
		<Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
		<Content Update="config.json" CopyToPublishDirectory="Never" />
		<Content Update="keybinds.json" CopyToPublishDirectory="Never" />
		<!--<EmbeddedResource Remove="TestFolder\**" />
		<EmbeddedResource Remove="appsettings*.json" />
		<EmbeddedResource Remove="config.json" />-->
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Blazored.Toast" Version="4.2.1" />
		<PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.1.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\COPYING" Pack="True" PackagePath="\" />
		<None Include="..\..\README.md" Pack="True" PackagePath="\" />
	</ItemGroup>

</Project>
